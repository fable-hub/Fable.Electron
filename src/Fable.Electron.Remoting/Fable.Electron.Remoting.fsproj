<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <FablePackageType>library</FablePackageType>
        <OutputType>Library</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        
        <PackageId>Fable.Electron.Remoting</PackageId>
        <Title>Fable.Electron.Remoting</Title>
        <RootNamespace>Fable.Electron.Remoting</RootNamespace>
        <AssemblyName>Fable.Electron.Remoting</AssemblyName>
        <Company>Fable-Hub</Company>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/fable-hub/fable-electron</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>Fable;F#;FSharp;Electron;Bindings;Native;JavaScript;JS;Remoting;fable-javascript</PackageTags>
        <Authors>Shayan Habibi and Contributors</Authors>
        <Copyright>Copyright (c) 2025 Shayan Habibi and Fable-Hub contributors</Copyright>
        <PackageVersion>7.0.0</PackageVersion>
        <Version>7.0.0</Version>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GitNetInitialVersion>0.1.0</GitNetInitialVersion>
        <PackageIcon>feleico-dark.png</PackageIcon>

    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="\" />
        <None Include="../../docs/static/img/feleico-dark.png">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
            <Link>Public/icon.png</Link>
        </None>
        <Compile Include="Renderer.fs" />
        <Compile Include="Preload.fs" />
        <Compile Include="Main.fs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Fable.Electron\Fable.Electron.fsproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Fable.SimpleJson" Version="3.24.0" />
        <PackageReference Include="Fable.Package.SDK" Version="1.3.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

</Project>
